# Copy to backend/.env; never commit real values. Load with uvicorn --env-file .env.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Exact HTTPS URI registered in Meta; same public origin as the dashboard:
INSTAGRAM_REDIRECT_URI=https://your-studio.example/api/integrations/instagram/callback
STUDIO_FRONTEND_URL=https://your-studio.example
# Generate once using Fernet.generate_key(); keep stable and back up separately.
TOKEN_ENCRYPTION_KEY=
# Generate a random key of at least 32 characters. This is NOT a social password.
STUDIO_ADMIN_KEY=
