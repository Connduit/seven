# Copy to backend/.env; never commit real values. Load with uvicorn --env-file .env.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Exact HTTPS URI registered in Meta; same public origin as the dashboard:
INSTAGRAM_REDIRECT_URI=https://your-studio.example/api/integrations/instagram/callback
STUDIO_FRONTEND_URL=https://your-studio.example
# Generate once using Fernet.generate_key(); keep stable and back up separately.
TOKEN_ENCRYPTION_KEY=
# Generate a random key of at least 32 characters. This is NOT a social password.
STUDIO_ADMIN_KEY=

# Optional independent account-linking providers. Configure only those you need.
# Google can use http://localhost:5173 for local testing; all callbacks go through Vite's /api proxy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-studio.example/api/integrations/tiktok/callback

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=https://your-studio.example/api/integrations/snapchat/callback
